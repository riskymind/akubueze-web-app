generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHAIRMAN
  FINSEC
  SECRETARY
  // Read-only: dashboard, members, levies, meetings. No record-payments,
  // manage, create, or upload permissions.
  MEMBER
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  name         String
  role         Role
  memberId     String? @unique
  member       Member? @relation(fields: [memberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id       String   @id @default(cuid())
  name     String
  phone    String
  joinDate DateTime

  dues           Due[]
  levyPayments   LevyPayment[]
  hostedMeetings Meeting[]     @relation("MeetingHost")
  hostedLevies   Levy[]        @relation("LevyHost")
  user           User?

  createdAt DateTime @default(now())
}

model Meeting {
  id       String   @id @default(cuid())
  label    String
  date     DateTime
  recorded Boolean  @default(false)

  // The hosting member pays the elevated host rate for this meeting
  // (see HOST_DUES_AMOUNT in lib/constants.ts) instead of the regular rate.
  hostId String
  host   Member @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Restrict)

  minutesFileName String?
  minutesFilePath String?
  minutesFileType String?

  dues Due[]

  createdAt DateTime @default(now())
}

model Due {
  id        String  @id @default(cuid())
  memberId  String
  meetingId String
  paid      Boolean @default(false)
  late      Boolean @default(false)

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([memberId, meetingId])
}

model Levy {
  id          String   @id @default(cuid())
  name        String
  amount      Int      @default(5000)
  dateCreated DateTime @default(now())

  // Set for levies raised for a specific member's event (wedding, funeral,
  // child dedication, etc.) — that member is exempt from paying it. Left
  // unset for general levies, which every member pays.
  hostId String?
  host   Member? @relation("LevyHost", fields: [hostId], references: [id], onDelete: Restrict)

  payments LevyPayment[]
}

model LevyPayment {
  id       String  @id @default(cuid())
  levyId   String
  memberId String
  paid     Boolean @default(false)

  levy   Levy   @relation(fields: [levyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([levyId, memberId])
}
